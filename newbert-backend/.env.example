# Copy this file to .env and add your own values. Never commit .env.
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/newbert?retryWrites=true&w=majority
MONGODB_DB=newbert
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
